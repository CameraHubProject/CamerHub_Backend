# Neon: use the DIRECT endpoint (without -pooler), an EMPTY dedicated database,
# and keep credentials separate from the URL. Never paste secrets into chat.
DB_URL=jdbc:postgresql://YOUR_DIRECT_NEON_HOST/YOUR_EMPTY_DATABASE?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Used only by the optional local PostgreSQL 16 Docker Compose service.
POSTGRES_DB=camerahub_dev
POSTGRES_USER=camerahub
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set in phase 1; no default signing secret is supplied.
JWT_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_ENABLED=true
AI_MODERATION_ENABLED=true
AI_WEB_SEARCH_ENABLED=true
# Per backend process, resets daily (Asia/Ho_Chi_Minh). Also enforce project spend limits at OpenAI.
AI_DAILY_REQUEST_LIMIT=200
STORAGE_ROOT=./storage

# Business durations and cancellation rates remain undecided, not invented.
# Add explicit policy settings in the corresponding implementation phase.
