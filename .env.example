# One existing Neon database. Keep credentials separate from the JDBC URL.
DB_URL=jdbc:postgresql://YOUR_DIRECT_NEON_HOST/camerahub_mvp_dev?sslmode=require&channelBinding=require
DB_USERNAME=
DB_PASSWORD=
PORT=8080
FRONTEND_URL=http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
# backend.cmd generates stable RSA keys and a serial fingerprint key under .local/render/keys.
# Never replace production keys during a routine build/deploy.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_WEB_SEARCH_ENABLED=true
AI_DAILY_REQUEST_LIMIT=200
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
CAMERAHUB_MEDIA_ROOT=storage/product-media
